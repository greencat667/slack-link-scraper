{
  "manifest_version": 3,
  "name": "Slack Link Scraper",
  "version": "0.1.0",
  "description": "Extract links from Slack web channels or threads and export as HTML or Markdown.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "downloads",
    "clipboardWrite",
    "sidePanel"
  ],
  "host_permissions": ["https://app.slack.com/*", "https://*.slack.com/*"],
  "action": {
    "default_title": "Slack Link Scraper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://app.slack.com/*", "https://*.slack.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
